{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=education;Username=app;Password=secret;"
  },
  "Jwt": {
    "Issuer": "EducationServer",
    "Audience": "EducationClient",
    "SecretKey": "change-me-minimum-32-characters-secret-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "uploads",
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minio",
    "SecretKey": "minio123",
    "PresignedUrlMinutes": 15,
    "BucketAvatars": "edu-avatars",
    "BucketHomeworks": "edu-homeworks",
    "BucketArchives": "edu-homework-archives",
    "BucketVideos": "edu-videos",
    "MaxFileSizeMb": 20,
    "MaxArchiveSizeMb": 200
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:8080",
      "http://127.0.0.1:5500"
    ]
  },
  "RateLimit": {
    "GlobalPerMinute": 100,
    "LoginPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}